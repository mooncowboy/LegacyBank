<?xml version="1.0" encoding="utf-8"?>
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
  </system.web>
  <log4net>
    <root>
      <level value="DEBUG" xdt:Transform="Replace" />
    </root>
  </log4net>
</configuration>
